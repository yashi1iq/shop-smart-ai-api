# Copy this file to .env and fill in only the values you actually have.
# Leave a retailer's variables blank/unset if you don't have credentials for
# it yet — its adapter will correctly report status "not_connected" instead
# of crashing or faking data.

# ---- Amazon Product Advertising API (PA-API v5) -----------------------
# Requires an approved Amazon Associates (India) account with PA-API access.
# Apply: https://webservices.amazon.in/paapi5/documentation/
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1
AMAZON_MARKETPLACE=www.amazon.in

# ---- Flipkart Affiliate API --------------------------------------------
# Requires an approved Flipkart Affiliate account.
# Apply: https://affiliate.flipkart.com/api-docs
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ---- Croma / Reliance Digital / Vijay Sales ----------------------------
# As of writing, none of these publish a public product/pricing API or
# affiliate feed. There is nothing to put here. If that changes (a
# retailer opens a partner/affiliate program), add its adapter the same
# way amazonAdapter.js / flipkartAdapter.js are structured.
# CROMA_API_KEY=
# RELIANCE_API_KEY=
# VIJAY_SALES_API_KEY=

PORT=3000

# ---- API / deployment ---------------------------------------------------
# Comma-separated frontend origins. Use "*" for local development only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
