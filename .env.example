# Copy to .env for local development. On Railway, set these in the Variables tab instead.

# --- Required ---
ZENROWS_API_KEY=

# --- Recommended for production ---
# Only your site may call the API (comma separated, no trailing slash). Default is open to everyone.
# CORS_ORIGINS=https://your-site.example,https://www.your-site.example
# Hard daily cap on ZenRows requests, so a bug or a crawler cannot drain your credits.
MAX_ZENROWS_REQUESTS_PER_DAY=1500
# Per-IP requests per minute.
RATE_LIMIT_PER_MIN=60

# --- Optional ---
# Stores to query: amazon, flipkart
# STORES=amazon,flipkart
# RESULTS_PER_STORE=10
# CACHE_TTL_MINUTES=30
# ZENROWS_PROXY_COUNTRY=in

# Turn JS rendering on for a store only if it returns zero products (costs more credits).
# ZENROWS_JS_FLIPKART=true
# ZENROWS_JS_AMAZON=false
# ZENROWS_PREMIUM_AMAZON=true

# Official YouTube Data API v3 key. If unset, YouTube results are scraped through ZenRows.
# YOUTUBE_API_KEY=

# Enables GET /api/debug/scrape (send header X-Admin-Token). Leave unset to keep it disabled.
# ADMIN_TOKEN=

# Railway sits behind one proxy hop. Used to read the real client IP for rate limiting.
# TRUST_PROXY_HOPS=1
# DEBUG=false
