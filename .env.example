PORT=3000
# Prices (ScrapingBee)
SCRAPINGBEE_API_KEY=
AMAZON_AFFILIATE_TAG=
# Riya (Anthropic API, server-side only)
ANTHROPIC_API_KEY=
RIYA_MODEL=claude-sonnet-5-5
# YouTube reviews (optional; falls back to YouTube search links)
YOUTUBE_API_KEY=
# CORS: comma-separated, blank = allow all
ALLOWED_ORIGINS=https://gilded-ganache-426eef.netlify.app
# Storage (mount a Railway Volume here so saved items/alerts survive redeploys)
DATA_DIR=./data
# Tuning
CACHE_MINUTES=30
ALERT_INTERVAL_HOURS=6
# Browser push for price alerts (optional): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
