# Required: your ZenRows API key (do not commit your real key)
ZENROWS_API_KEY=replace_with_your_zenrows_api_key

# Optional: set true only if your ZenRows plan supports/needs these options
ZENROWS_JS_RENDER=false
ZENROWS_PREMIUM_PROXY=false
# Optional custom target URLs
# ZENROWS_SEARCH_URL=https://www.google.com/search
# ZENROWS_YOUTUBE_URL=https://www.youtube.com/results
# ZENROWS_API_URL=https://api.zenrows.com/v1/

PORT=3000
NODE_ENV=production
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en
CACHE_TTL_SECONDS=180
MAX_RESULTS=24
PROVIDER_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=https://shopsmart-ai.netlify.app,http://localhost:3000,http://127.0.0.1:3000
AMAZON_ASSOCIATE_TAG=shopsmartai03-21
# Optional ONLY if you have a valid, tested Awin tracking template containing {url}
# AWIN_TRACKING_TEMPLATE=https://your-valid-awin-click-url.example/?url={url}
