# Required: create a SerpApi account and put your private API key here.
SERPAPI_KEY=your_serpapi_key

# Optional
PORT=3000
DEFAULT_LOCATION=Hyderabad, Telangana, India
DEFAULT_COUNTRY=in
DEFAULT_LANGUAGE=en

# Comma-separated browser origins. Use * for initial testing only.
CORS_ORIGINS=*

# Cache lifetime in seconds. Helps reduce repeated API calls.
CACHE_TTL_SECONDS=60
