# Copy to .env for local development. On Railway, set these in the service Variables tab.

# --- Required for real data ---------------------------------------------------
# Google Shopping results (prices, stores, ratings). Get a key at https://serpapi.com
SERPAPI_KEY=
# YouTube review videos. Enable "YouTube Data API v3" in Google Cloud and create an API key.
YOUTUBE_API_KEY=

# --- Optional -----------------------------------------------------------------
# Comma-separated list of sites allowed to call this API from a browser.
# "*" allows any site (fine for a public read-only API).
ALLOWED_ORIGINS=*

# How long search results are cached. The app re-checks every 30 s, so this protects your SerpAPI quota.
SEARCH_CACHE_SECONDS=900
# YouTube search costs 100 quota units of your 10,000 daily units, so cache it for a long time.
YOUTUBE_CACHE_SECONDS=86400

# Requests allowed per IP per minute.
RATE_LIMIT_PER_MINUTE=60
# Maximum offers returned per search.
MAX_RESULTS=40

# Local development only: serve generated sample offers when no SERPAPI_KEY is set.
# Never enable this in production, because the app would show sample prices as if they were live.
MOCK=0

# Railway sets PORT for you.
PORT=3000

# Set to 1 only if you run behind your own reverse proxy. On Railway this is detected automatically.
TRUST_PROXY=0
